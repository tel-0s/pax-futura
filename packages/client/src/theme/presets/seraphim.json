  "font": {
    "ui": "'Chakra Petch', system-ui, sans-serif",
    "display": "'Chakra Petch', system-ui, sans-serif",
    "mono": "'JetBrains Mono Variable', 'SF Mono', ui-monospace, monospace",
    "scale": { "xs": "11.5px", "sm": "13px", "md": "14.5px", "lg": "17.5px", "xl": "27px" }
