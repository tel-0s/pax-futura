{
  "meta": {
    "id": "seraphim",
    "name": "Seraphim",
    "scheme": "dark",
    "tagline": "Machined charcoal, hazard orange, field-terminal type"
  },
  "color": {
    "surface": ["#101012", "#17171a", "#1f1f23", "#29292e"],
    "text": { "primary": "#f3efe8", "secondary": "#bfb9af", "muted": "#7f7a72", "inverse": "#101012" },
    "accent": { "base": "#ff812a", "hover": "#ff9d55", "subtle": "#3a2416" },
    "semantic": { "success": "#9ccc5a", "warning": "#f5c542", "danger": "#ff5644", "info": "#5bb3d6" },
    "border": { "subtle": "#2d2d32", "strong": "#47474e", "focus": "#ff812a" },
    "loom": { "canonicalEdge": "#ff812a", "siblingEdge": "#47474e", "nodeCurrent": "#ff9d55", "nodePending": "#f5c542" }
