{
  "meta": { "id": "parchment", "name": "Parchment", "scheme": "light" },
  "color": {
    "surface": ["#efe6d4", "#e7dcc6", "#ddd0b6", "#d2c3a5"],
    "text": { "primary": "#2e2618", "secondary": "#54492f", "muted": "#7d7156", "inverse": "#f4ecdd" },
    "accent": { "base": "#8a5a2b", "hover": "#a06b35", "subtle": "#e0cba8" },
