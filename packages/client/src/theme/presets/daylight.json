{
  "meta": { "id": "daylight", "name": "Daylight", "scheme": "light" },
  "color": {
    "surface": ["#f7f9fb", "#eef2f6", "#e3e9f0", "#d6dee8"],
    "text": { "primary": "#17202b", "secondary": "#45536a", "muted": "#7c8aa0", "inverse": "#f7f9fb" },
    "accent": { "base": "#2f6fd0", "hover": "#4a86e0", "subtle": "#dbe7f8" },
    "semantic": { "success": "#2e9e68", "warning": "#c98a1f", "danger": "#d0503f", "info": "#2f9cc0" },
    "border": { "subtle": "#d5dde7", "strong": "#b4c0d0", "focus": "#2f6fd0" },
    "loom": { "canonicalEdge": "#2f6fd0", "siblingEdge": "#b4c0d0", "nodeCurrent": "#4a86e0", "nodePending": "#c98a1f" }
  },
  "font": {
    "ui": "'Inter', system-ui, sans-serif",
    "display": "'Inter', system-ui, sans-serif",
    "mono": "'JetBrains Mono', 'SF Mono', monospace",
