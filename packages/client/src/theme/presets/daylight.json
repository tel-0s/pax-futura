  },
  "map": {
    "water": "#cfe2ef",
    "land": "#eef0e9",
    "terrainTintOpacity": 0.35,
    "boundary": { "line": "#9daebe", "disputed": "#c98a1f" },
    "label": { "color": "#17202b", "halo": "#f7f9fb", "glyphStack": "sans" },
    "graticule": "#e3e9f0",
    "selectionOutline": "#2f6fd0",
    "hoverFill": "#dbe7f8",
    "polityPalette": { "hueOffset": 0, "sat": [42, 65], "lum": [52, 68], "contested": "blend" }
  }
