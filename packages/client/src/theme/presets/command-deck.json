{
  "meta": {
    "id": "command-deck",
    "name": "Command Deck",
    "scheme": "dark",
    "tagline": "Strategic operations — glass, light and a turning globe"
  },
  "color": {
    "surface": [
      "#070b12",
      "#0c121c",
      "#131b28",
      "#1b2636"
    ],
    "text": {
      "primary": "#e8eef7",
      "secondary": "#a3b3c8",
      "muted": "#64778f",
      "inverse": "#04070c"
    },
    "accent": {
      "base": "#4aa8ff",
      "hover": "#7cc0ff",
      "subtle": "#11304f"
    },
    "semantic": {
      "success": "#3fd69a",
      "warning": "#f0b94d",
      "danger": "#ff6b5e",
      "info": "#53d0f0"
    },
    "border": {
      "subtle": "#1d293a",
      "strong": "#30425a",
      "focus": "#4aa8ff"
