      "nodeCurrent": "#7cc0ff",
      "nodePending": "#f0b94d"
    }
  },
  "font": {
    "ui": "'Inter Variable', 'Inter', system-ui, sans-serif",
    "display": "'Barlow Semi Condensed', 'Inter Variable', system-ui, sans-serif",
    "mono": "'JetBrains Mono Variable', 'SF Mono', ui-monospace, monospace",
    "scale": {
      "xs": "11px",
      "sm": "12.5px",
      "md": "14px",
      "lg": "17px",
      "xl": "26px"
