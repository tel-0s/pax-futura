    "waterPattern": "grid",
    "landTexture": "none",
    "textureStrength": 0.2,
    "fillOpacity": 0.8,
    "borderBand": 2.5,
    "boundaryDash": [],
    "vignette": 0.5,
    "ornament": "hud"
